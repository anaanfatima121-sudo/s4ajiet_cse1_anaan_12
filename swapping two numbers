code for swapping two numbers
java code:
public class swap {
    public static void main(String[] args) {
        int a=10;
        int b=5;
        System.out.println("bfor swap a="+a+ " and b="+b);
        int temp=a;
        a=b;
        b=temp;
        System.out.println("After swap a="+a+ " and b="+b);
    }
}
