class Solution {
    public void reverseString(char[] s) {
        StringBuilder sb = new StringBuilder(new String(s));
        sb.reverse();
        for (int i = 0; i < s.length; i++) {
            s[i] = sb.charAt(i);
        }
    }
}

class Main {
    public static void main(String[] args) {
        String s="hello";
        String rev=" ";
        for(int i=0;i<s.length();i++)
        {
            rev=s.charAt(i)+rev;
        }
        System.out.println(rev);
    }
}

